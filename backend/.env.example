# NetShield Dashboard - Environment Variables
# ================================================
# Copy this file to .env and fill in real values

# MikroTik CHR API
MIKROTIK_HOST=192.168.0.27
MIKROTIK_PORT=8728
MIKROTIK_USER=admin
MIKROTIK_PASSWORD=admin

# Wazuh SIEM API
WAZUH_HOST=192.168.0.166
WAZUH_PORT=55000
WAZUH_USER=wazuh
WAZUH_PASSWORD=wazuh

# Wazuh Indexer (OpenSearch 7.10) — real alerts + vulnerabilities live here, NOT in Server API
WAZUH_INDEXER_URL=https://192.168.0.166:9200
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASSWORD=admin
WAZUH_INDEXER_VERIFY_SSL=false

# OpenRouter AI (proxy de modelos gratuitos, compatible con OpenAI API)
# Clave gratuita en: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto  # Modelo por defecto (auto-selecciona modelo gratuito)

# Database (SQLite for lab, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./netshield.db

# Redis (optional - system works without it)
REDIS_URL=redis://localhost:6379

# App Settings
APP_ENV=development
LOG_LEVEL=DEBUG
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# GLPI (Asset Management / Inventario) — High-Level API v3.0 (OAuth2)
GLPI_URL=http://localhost
GLPI_API_URL=http://localhost/api.php
GLPI_API_VERSION=v3.0
GLPI_CLIENT_ID=ID
GLPI_CLIENT_SECRET=SECRET
GLPI_USERNAME=glpi
GLPI_PASSWORD=glpi
GLPI_VERIFY_SSL=false

# API legacy (v1) — necesaria SOLO para leer la IP de los activos.
# La HLAPI v3.0 no expone NetworkPort/IPAddress; la v1 sí, vía la cadena
# IPAddress → NetworkName → NetworkPort. Sin estos dos tokens la columna IP
# queda vacía (la vista funciona igual).
#   GLPI_APP_TOKEN  → Configuración → General → API → cliente API → App-Token
#   GLPI_USER_TOKEN → Administración → Usuarios → (usuario) → pestaña API → Token de la API
GLPI_APP_TOKEN=
GLPI_USER_TOKEN=

# ── Portal público de tickets (/soporte, sin autenticación) ─────────────────
# Permite crear tickets desde una URL abierta usando el email como
# identificador (no se valida identidad) y consultar el estado con ID + email.
# Requiere GLPI_APP_TOKEN + GLPI_USER_TOKEN para los adjuntos.
PUBLIC_TICKETS_ENABLED=false
PUBLIC_TICKETS_RATE_LIMIT=5      # tickets por IP por hora
PUBLIC_TICKETS_MAX_MB=5          # tamaño máximo de adjunto

# ── Mock Mode ───────────────────────────────────────────────────────────────
# Activa datos simulados sin necesitar sistemas externos corriendo.
#
# Modos disponibles:
#   MOCK_ALL=true        → todos los servicios en mock (modo demo completo)
#   MOCK_MIKROTIK=true   → solo MikroTik en mock, el resto real
#   MOCK_WAZUH=true      → solo Wazuh en mock, el resto real
#   MOCK_GLPI=true       → solo GLPI en mock, el resto real
#   MOCK_AI=true         → solo OpenRouter AI en mock, el resto real
#
# Combinación: MOCK_ALL activa todo; los flags individuales son OR sobre MOCK_ALL.
# Híbrido: MOCK_ALL=false + MOCK_GLPI=true → GLPI mock, MikroTik/Wazuh reales.
#
# Retrocompat: APP_ENV=lab sin ninguna variable MOCK_* definida = MOCK_ALL=true
# Para usar APP_ENV=lab con servicios reales: agregar MOCK_ALL=false explícitamente.
#
MOCK_ALL=false
# MOCK_MIKROTIK=false
# MOCK_WAZUH=false
# MOCK_GLPI=false
# MOCK_AI=false
# MOCK_CROWDSEC=false   # false = intenta conectar al CrowdSec real

# ── CrowdSec IPS (Collaborative Security) ─────────────────────────────────
# Para activar CrowdSec real:
#   1. Instalar CrowdSec en el servidor
#   2. Registrar el bouncer de MikroTik con "cscli bouncers add netshield-bouncer"
#   3. Completar CROWDSEC_URL y CROWDSEC_API_KEY
#   4. Cambiar MOCK_CROWDSEC=false (o no definirla, si MOCK_ALL=false)
CROWDSEC_URL=http://localhost:8080
CROWDSEC_API_KEY=

# ── GeoIP (Geolocalización local de IPs) ───────────────────────────────
# Base de datos MaxMind GeoLite2 para geolocalización local sin API externa.
# Descargar: python backend/scripts/download_geoip.py
# Registro gratuito en: https://www.maxmind.com/en/geolite2/signup
#
# MOCK_GEOIP=true  → usa datos simulados (por defecto, hasta descargar la DB)
# MOCK_GEOIP=false → requiere las DBs .mmdb descargadas en las rutas indicadas
GEOIP_CITY_DB=backend/data/geoip/GeoLite2-City.mmdb
GEOIP_ASN_DB=backend/data/geoip/GeoLite2-ASN.mmdb
MAXMIND_LICENSE_KEY=
MOCK_GEOIP=true



# ── Telegram Bot (Notificaciones Bidireccionales) ──────────────────────────
# Bot de Telegram para alertas outbound y consultas inbound via IA.
# Crear bot: https://core.telegram.org/bots#botfather → /newbot
# Obtener chat_id: enviar un mensaje al bot y consultar
#   https://api.telegram.org/bot<TOKEN>/getUpdates
#
# MOCK_TELEGRAM=true  → datos simulados (por defecto, hasta configurar bot)
# MOCK_TELEGRAM=false → requiere token válido y chat_id configurado
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ADMIN_CHAT_IDS=
MOCK_TELEGRAM=true

# ── Auth / JWT (Dashboard Authentication) ──────────────────────────────────
# JWT_SECRET_KEY es OBLIGATORIO. El backend falla al arrancar si no está configurado.
# Generá un valor seguro con:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Mínimo 32 caracteres. Cambiar si el servidor es comprometido.
JWT_SECRET_KEY=2db7b36c3bc296ace08b5612e06633ad2ffe7c72089e8aa2c500674636aa1834
JWT_EXPIRE_MINUTES=60

# ── Audit / Action Log ──────────────────────────────────────────────────────
# Nivel mínimo de severidad para registrar acciones en el historial.
# Jerarquía: critical > high > medium > low > info
# Default "info" = registrar absolutamente todo.
# Ejemplo: AUDIT_MIN_SEVERITY=medium → solo registra medium, high y critical.
AUDIT_MIN_SEVERITY=info

# Prefijos de action_type a EXCLUIR del registro, separados por coma.
# Útil para silenciar categorías de bajo interés sin perder las importantes.
# Ejemplo: AUDIT_DISABLED_ACTIONS=network_label_,view_,cli_
# Default vacío = no excluir nada (registrar todo lo que pase el nivel mínimo).
AUDIT_DISABLED_ACTIONS=
