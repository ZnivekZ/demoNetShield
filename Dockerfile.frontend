# =============================================================================
# Dockerfile.frontend — NetShield Dashboard Frontend
# Node 22 Alpine (build) → Nginx Alpine (serve)
# =============================================================================

# ── Stage 1: Build ────────────────────────────────────────────────────────────
# Compila el React/Vite SPA a archivos estáticos optimizados
FROM node:22-alpine AS builder

WORKDIR /app

# Copiar manifests primero para cachear la capa de node_modules
COPY frontend/package.json frontend/package-lock.json ./

# npm ci: instalación limpia y reproducible (usa package-lock.json exacto)
RUN npm ci

# Copiar el resto del código fuente del frontend
COPY frontend/ .

# Build de producción: tsc (type-check) + vite build → genera dist/
RUN npm run build


# ── Stage 2: Serve ────────────────────────────────────────────────────────────
# Imagen final ultra liviana: Nginx Alpine (~40MB total)
FROM nginx:alpine

LABEL maintainer="NetShield Dashboard" \
      version="2.9" \
      description="NetShield Dashboard Frontend — Nginx static server + reverse proxy"

# Copiar los archivos estáticos compilados desde el stage builder
COPY --from=builder /app/dist /usr/share/nginx/html

# Copiar la configuración de Nginx (reverse proxy + SPA fallback)
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

# Healthcheck nativo de Nginx
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q --spider http://localhost:80/ || exit 1

# nginx se ejecuta en foreground (necesario para Docker)
CMD ["nginx", "-g", "daemon off;"]
